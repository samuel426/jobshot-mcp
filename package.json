{
  "name": "jobshot-mcp",
  "version": "0.3.0-dev.1",
  "private": true,
  "description": "Local job-posting intake and personal-material tools for JobShot",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check": "npm test && node scripts/check-foundation.mjs",
    "check:codex": "npm run build && node scripts/check-codex-connection.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "24.19.2",
    "jsdom": "29.0.0",
    "typescript": "7.0.2"
  }
}
